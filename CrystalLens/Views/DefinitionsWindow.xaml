<Window x:Class="CrystalLens.Views.DefinitionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrystalLens.Views"
        mc:Ignorable="d"
        Title="Definitions" Height="450" Width="800"
        Icon="/Assets/Images/Icon.ico"
        WindowStyle="ThreeDBorderWindow"
        ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <DockPanel>
        <DataGrid CanUserSortColumns="False" ItemsSource="{Binding}" AutoGenerateColumns="False" IsReadOnly="True"
                  HorizontalGridLinesBrush="#ACACAC" VerticalGridLinesBrush="#ACACAC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Symbol" Binding="{Binding Key}" Width="*"/>
                <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>

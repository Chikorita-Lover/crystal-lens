<Application x:Class="CrystalLens.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:CrystalLens"
             xmlns:properties="clr-namespace:CrystalLens.Properties"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <Style x:Key="TextColumnElementStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <properties:Settings x:Key="AppSettings"/>
    </Application.Resources>
</Application>

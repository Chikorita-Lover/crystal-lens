<Window x:Class="CrystalLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrystalLens"
        xmlns:vm="clr-namespace:CrystalLens.ViewModels"
        xmlns:views="clr-namespace:CrystalLens.Views"
        mc:Ignorable="d"
        Title="Crystal Lens" Height="545" Width="970">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="ApplicationCommands.Close"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed"/>
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" CanExecute="Close_CanExecute"/>
    </Window.CommandBindings>
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="_Open..." Command="ApplicationCommands.Open"/>
                    <Separator/>
                    <MenuItem Header="_Save" IsEnabled="False"/>
                    <MenuItem Header="Save _As..." IsEnabled="False"/>
                    <Separator/>
                    <MenuItem Header="_Close" Command="ApplicationCommands.Close" InputGestureText="Ctrl+W"/>
                    <Separator/>
                    <MenuItem Header="E_xit"/>
                </MenuItem>
            </Menu>
            <TabControl Name="tabs" ItemsSource="{Binding OpenFiles}">
                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}"/>
                            <StackPanel.ToolTip>
                                <TextBlock Text="{Binding Path}"/>
                            </StackPanel.ToolTip>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <views:EncounterTableMapView EncounterTables="{Binding EncounterTables}"/>
                    </DataTemplate>
                </TabControl.ContentTemplate>
            </TabControl>
        </DockPanel>
    </Grid>
</Window>

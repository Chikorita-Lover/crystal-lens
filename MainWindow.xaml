<Window x:Class="CrystalLens.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CrystalLens"
        xmlns:converters="clr-namespace:CrystalLens.Converters"
        xmlns:vm="clr-namespace:CrystalLens.ViewModels"
        xmlns:views="clr-namespace:CrystalLens.Views"
        xmlns:properties="clr-namespace:CrystalLens.Properties"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="545" Width="970" 
        Icon="/Assets/Images/Icon.ico" 
        Closing="Window_Closing">
    <Window.Resources>
        <converters:ObjectNotNullConverter x:Key="ObjectNotNullConverter"/>
        <HierarchicalDataTemplate DataType="{x:Type vm:ASMProjectViewModel+FolderEntry}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path Data="M0 0H4.5l1.5 1.5H12V9H0z" Fill="DarkSlateGray" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Margin="6,0,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <HierarchicalDataTemplate DataType="{x:Type vm:ASMProjectViewModel+FileEntry}" ItemsSource="{Binding Children}">
            <StackPanel Orientation="Horizontal">
                <Path Data="M1.5 0h6l3 3v9h-9z" Fill="DarkSlateGray" Width="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Margin="6,0,0,0"/>
            </StackPanel>
        </HierarchicalDataTemplate>
        <DataTemplate DataType="{x:Type vm:ASMProjectViewModel+LabelEntry}">
            <StackPanel Orientation="Horizontal">
                <Path Data="M1.5 3.5a1 1 90 00-1 1v4h1v-2h1v2h1v-4a1 1 90 00-1-1h-1m0 1h1v1h-1m6-.25V4.5a1 1 90 00-1-1h-2v5h2a1 1 90 001-1V6.75A.77.77 90 006.75 6a.77.77 90 00.75-.75M6.5 7.5h-1v-1h1v1m0-2h-1v-1h1m3-1a1 1 90 00-1 1v3a1 1 90 001 1h1a1 1 90 001-1V7h-1v.5h-1v-3h1V5h1V4.5a1 1 90 00-1-1Z" Fill="DarkSlateGray" Width="12" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding Name}" Margin="6,0,0,0"/>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>
    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{x:Static local:MainWindow.OpenProjectCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="ApplicationCommands.SaveAs"/>
        <KeyBinding Key="W" Modifiers="Ctrl" Command="ApplicationCommands.Close"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding NextTabCommand}"/>
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding PreviousTabCommand}"/>
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static local:MainWindow.OpenProjectCommand}" Executed="OpenProject_Executed"/>
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" CanExecute="Save_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" CanExecute="Save_CanExecute"/>
        <CommandBinding Command="ApplicationCommands.Close" Executed="Close_Executed" CanExecute="Close_CanExecute"/>
    </Window.CommandBindings>
    <Grid>
        <DockPanel>
            <Menu DockPanel.Dock="Top">
                <MenuItem Header="_File">
                    <MenuItem Header="Open Project..." Command="{x:Static local:MainWindow.OpenProjectCommand}" InputGestureText="Ctrl+Shift+O"/>
                    <Separator/>
                    <MenuItem Header="_Save" Command="ApplicationCommands.Save"/>
                    <MenuItem Header="Save _As..." Command="ApplicationCommands.SaveAs" InputGestureText="Ctrl+Shift+S"/>
                    <Separator/>
                    <MenuItem Header="_Close" Command="ApplicationCommands.Close" InputGestureText="Ctrl+W"/>
                    <Separator/>
                    <MenuItem Header="E_xit"/>
                </MenuItem>
                <MenuItem Header="_Tools">
                    <MenuItem Header="Pokémon Search..." Click="PokemonSearch_Click" IsEnabled="{Binding OpenProject,Converter={StaticResource ObjectNotNullConverter}}"/>
                </MenuItem>
            </Menu>
            <Grid Name="ContentGrid">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding Source={x:Static properties:Settings.Default},Path=ProjectExplorerWidth,Mode=TwoWay}" MinWidth="25" MaxWidth="600"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Label Grid.Row="0" Content="Project Explorer"/>
                    <TreeView Name="ProjectExplorer" Grid.Row="1" ItemsSource="{Binding OpenProject.Entries}" HorizontalAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <EventSetter Event="MouseDoubleClick" Handler="ListViewItem_MouseDoubleClick"/>
                                <Setter Property="ToolTip" Value="{Binding Path}"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.Style>
                            <Style TargetType="TreeView">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadingProject}" Value="True">
                                        <Setter Property="Opacity" Value="0.25"/>
                                        <Setter Property="IsEnabled" Value="False"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LoadingProject}" Value="False">
                                        <Setter Property="Opacity" Value="1.0"/>
                                        <Setter Property="IsEnabled" Value="True"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TreeView.Style>
                    </TreeView>
                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <Label Content="Opening project..." HorizontalContentAlignment="Center"/>
                        <ProgressBar IsIndeterminate="True" Height="4"/>
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LoadingProject}" Value="True">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding LoadingProject}" Value="False">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                    </StackPanel>
                </Grid>
                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" MouseDoubleClick="GridSplitter_MouseDoubleClick"/>
                <TabControl Grid.Column="2" Name="tabs" ItemsSource="{Binding OpenTabs}" SelectedIndex="{Binding SelectedTabIndex,Mode=TwoWay}">
                    <TabControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}"/>
                                <Button Width="18" Height="18" Background="Transparent" BorderBrush="Transparent" Margin="4,0,0,0"
                        Command="ApplicationCommands.Close" CommandParameter="{Binding Header,RelativeSource={RelativeSource AncestorType={x:Type TabItem}}}">
                                    <Image>
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="True">
                                                        <Setter Property="Source" Value="/Assets/Images/Unsaved.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding HasUnsavedChanges}" Value="False">
                                                        <Setter Property="Source" Value="/Assets/Images/Close.png"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsMouseOver,RelativeSource={RelativeSource AncestorType={x:Type Button}}}" Value="True">
                                                        <Setter Property="Source" Value="/Assets/Images/Close.png"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                </Button>
                                <StackPanel.ToolTip>
                                    <TextBlock Text="{Binding Path}"/>
                                </StackPanel.ToolTip>
                            </StackPanel>
                        </DataTemplate>
                    </TabControl.ItemTemplate>
                    <TabControl.Resources>
                        <DataTemplate DataType="{x:Type vm:ASMFileViewModel}">
                            <ContentPresenter Content="{Binding Data}"/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:EncounterTableMapViewModel}">
                            <views:EncounterTableMapView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:EncounterSetMapViewModel}">
                            <views:EncounterSetMapView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:EncounterSetViewModel}">
                            <views:EncounterSetView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PokemonStatsViewModel}">
                            <views:PokemonStatsView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:EvolutionMoveSetViewModel}">
                            <views:EvolutionMoveSetView/>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:PokemonSearchViewModel}">
                            <views:PokemonSearchView/>
                        </DataTemplate>
                    </TabControl.Resources>
                    <TabControl.ItemContainerStyle>
                        <Style TargetType="TabItem">
                            <Setter Property="Padding" Value="6,2,2,2"/>
                        </Style>
                    </TabControl.ItemContainerStyle>
                </TabControl>
            </Grid>
        </DockPanel>
    </Grid>
</Window>
